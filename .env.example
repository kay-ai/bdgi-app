# core
APP_URL=http://localhost:3000
# Leave DATABASE_URL empty to use the embedded PGlite database in .data/pglite (local only).
DATABASE_URL=
ENCRYPTION_KEY=
DEFAULT_LOCALE=en
TZ_DISPLAY=Africa/Lagos
# providers: console logs to the terminal and the message table
WHATSAPP_PROVIDER=console
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# How families are reached (D-018): email (default) or phone.
CONTACT_MODE=email
# Email over SMTP (EMAIL_PROVIDER=smtp). Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BGDI <hello@example.org>"
PAYMENTS_PROVIDER=console
# Paystack (PAYMENTS_PROVIDER=paystack). Test key (sk_test_...) locally and on staging.
# The webhook URL to set in the Paystack dashboard is {APP_URL}/api/webhooks/paystack.
PAYSTACK_SECRET_KEY=
# Live keys (sk_live_...) are refused unless this is true. Set it only in production secrets.
PAYSTACK_ALLOW_LIVE=false
# Speech coach. console works without keys; groq uses GROQ_MODEL (default openai/gpt-oss-120b).
AI_PROVIDER=console
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Listening: console | groq (Whisper) | aws (Amazon Transcribe, needs STORAGE_PROVIDER=s3)
TRANSCRIBE_PROVIDER=console
TRANSCRIBE_LANGUAGE=en-GB
# Where recordings wait to be scored (deleted afterwards): local | s3
STORAGE_PROVIDER=local
S3_BUCKET=
AWS_REGION=eu-west-2
# Vercel Cron sends this as a Bearer token to /api/cron/*. Required in production.
CRON_SECRET=
